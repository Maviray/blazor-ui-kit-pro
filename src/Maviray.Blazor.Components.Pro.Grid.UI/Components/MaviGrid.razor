    #region handle outside click

    protected async Task SubscribeElements()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            if (JsRuntime != null)
            {
                await JsRuntime.InvokeVoidAsync(
                    JsInteropConstants.REGISTER_OUT_OF_FOCUS_CALLBACK_LISTENER,
                    Id,
                    _dotNetRef,
                    "HandleOutsideClick");
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, ex.Message);
        }
    }

    [JSInvokable]
    public void HandleOutsideClick(string clickedMenuId)
    {
        try
        {
            // Close main menu if the click was NOT inside it
            if (clickedMenuId != _gridState.ContextMenuId)
            {
                _gridState.ContextMenuVisible = false;
            }

            // Close all row menus that were NOT clicked
            if (_collection != null)
            {
                foreach (var row in _collection.Rows.Where(row => clickedMenuId != row.ContextMenuId))
                {
                    row.ContextMenuVisible = false;
                }
            }

            _gridState.NeedsRender = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, ex.Message);
        }
    }

    private bool _disposed;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_disposed)
            {
                return;
            }

            if (HasRendered && JsRuntime != null)
            {
                await JsRuntime.InvokeVoidAsync(
                    JsInteropConstants.UN_REGISTER_OUT_OF_FOCUS_CALLBACK_LISTENER,
                    Id);
            }

            _dotNetRef?.Dispose();

            if (_filterDebounceCts is not null)
            {
                await _filterDebounceCts.CancelAsync();
                _filterDebounceCts.Dispose();
            }

            _disposed = true;
            GC.SuppressFinalize(this);

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, ex.Message);
        }
    }

    #endregion

    private async Task OnDialogButtonClick(DialogButtonClickEventArgs buttonClickArgs)
    {
        try
        {
            if (_maviBackdrop != null)
            {
                await _maviBackdrop.Display();
            }

            if (buttonClickArgs.ButtonClicked == DialogButtonClick.Confirm)
            {
                // Column visibility was toggled on the column objects directly. Drop the cached
                // visible-column list so it is rebuilt, and flag a render (ShouldRender gates on this).
                _visibleColumnsCache = null;
                _gridState.NeedsRender = true;
                StateHasChanged();
            }
            else
            {
                // Cancel / dismiss: revert the live edits the checkboxes made to the column objects.
                if (_columnVisibilitySnapshot != null && _collection != null)
                {
                    foreach (var column in _collection.Columns)
                    {
                        if (_columnVisibilitySnapshot.TryGetValue(column.Key, out var wasVisible))
                        {
                            column.Visible = wasVisible;
                        }
                    }
                }
            }

            _columnVisibilitySnapshot = null;

            if (_setVisibleColumnsDialog != null)
            {
                await _setVisibleColumnsDialog.Hide();
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "error attempting to display modal dialog that lets user manages column visibility.");
        }
        finally
        {
            if (_maviBackdrop != null)
            {
                await _maviBackdrop.Hide();
            }
        }
    }

    private async Task KickOffSetVisibleColumnsModal(MouseClickEventArgs args)
    {
        try
        {
            if (_setVisibleColumnsDialog != null)
            {
                // Capture current visibility so Cancel can restore it (the checkboxes mutate the
                // column objects directly while the dialog is open).
                _columnVisibilitySnapshot = _collection?.Columns.ToDictionary(c => c.Key, c => c.Visible);

                await _setVisibleColumnsDialog.Display();
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "error attempting to display modal dialog that lets user manages column visibility.");
        }
    }
