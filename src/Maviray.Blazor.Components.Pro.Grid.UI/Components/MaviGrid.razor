@using Maviray.Blazor.Components.Core.Constants
@using Maviray.Blazor.Components.Core.Enums
@using Maviray.Blazor.Components.Core.EventArgs
@using Maviray.Blazor.Components.Core.Extensions
@using Maviray.Blazor.Components.Material.Components.DataDisplay.Icons
@using Maviray.Blazor.Components.Material.Components.Feedback
@using Maviray.Blazor.Components.Material.Components.Inputs
@using Maviray.Blazor.Components.Material.Components.Spinner
@using Maviray.Blazor.Components.Material.Constants
@using Maviray.Blazor.Components.Pro.Core.Enums.Grid
@using Maviray.Blazor.Components.Pro.Core.Interfaces
@using Maviray.Blazor.Components.Pro.Core.Interfaces.Grid
@using Maviray.Blazor.Components.Pro.Core.Models.Grid
@using Maviray.Blazor.Components.Pro.Core.Models.Grid.Filter
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization
@using Maviray.Blazor.Components.Material.Extensions
@using Maviray.Blazor.Components.Pro.Core.Models.Grid.Menu
@inherits Maviray.Blazor.Components.Core.Components.MaviComponentBase
@typeparam TDataItem where TDataItem : class
@typeparam TModel where TModel : class, IGridCollectionModel<TDataItem, TKey>
@typeparam TKey where TKey : IEquatable<TKey>

    <div class="inline-block max-w-full rounded-xl border border-zinc-200 text-sm min-h-40 relative" style="overflow:auto">
    <MaviBackdrop @ref="_maviBackdrop"
                  Opacity="BackdropOpacity.Lighten"
                  ZIndex="ZIndex.Fifty"
                  CloseOnBackdropClick="false"
                  InitiallyActive="_gridState.BackdropInitialState"
                  CenterContent="true">
        <MaviSpinnerStarRotate ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Regular" />
    </MaviBackdrop>
    <MaviDialog @ref="_setVisibleColumnsDialog" DialogButtonClick="OnDialogButtonClick" MaviDialogBaseParameters="_maviDialogBaseParameters">
        <div class="space-4">
            @{
                var allColumns = _collection?.Columns.OrderBy(c => c.Sequence).ToList();
            }
            @if (allColumns is { Count: > 0 })
            {
                <div class="flex flex-col gap-4">
                    @foreach (var col in allColumns)
                    {
                        <MaviCheckbox @bind-Value="col.Visible"
                                      ElementSize="ElementSize.Regular"
                                      Label="@col.Title" />
                    }
                </div>
            }
        </div>
    </MaviDialog>
    @if (_collection != null && _collection.Rows.Any())
    {
        <div class="grid divide-y divide-zinc-200" style="grid-template-columns: repeat(@VisibleColumnsCount, minmax(min-content, 200px))">
            @* Header row *@
            @foreach (var column in GetVisibleColumns())
            {
                <div class="@GetColumnHeaderContainerCss(column)">
                    <div class="@GetColumnHeaderCss(column)">
                        <div class="@Tailwind.Theme.Typography.LABEL_LARGE cursor-pointer select-none transition-colors @Tailwind.Theme.Colors.Text.Hover.THEME_DEFAULT_TEN_TEXT_HOVER flex items-center gap-2"
                            @onclick="() => SortByColumn(column.Key)">
                            <span>@column.Title</span>
                            @if (_collection?.SortColumnKey == column.Key)
                            {
                                if (_collection?.SortOrder == SortOrder.Ascending)
                                {
                                    <i class="lni lni-chevron-down"></i>
                                }
                                else
                                {
                                    <i class="lni lni-chevron-up"></i>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            @* Select column header *@
            @if (Parameters?.DisplaySelectColumn == true)
            {
                <div class="@GetCellSpacing() truncate flex items-center justify-center">
                    <span class="@Tailwind.Theme.Typography.LABEL_LARGE @Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT select-none">Select</span>
                </div>
            }

            <div class="@GetContextMenuCellCss()">
                @if (_mainContextMenu is not null && _mainContextMenu.Any())
                {
                    <div id="@_gridState.ContextMenuId" data-context-menu-id="@_gridState.ContextMenuId" class="relative flex justify-end">
                        <!-- Btn Toggle Context Menu Dropdown -->
                        <MaviButtonIcon Icon="lni lni-menu-meatballs-1"
                                        ElementVariant="ElementVariant.Text"
                                        ThemeColorScheme="ThemeColorScheme.Default"
                                        ElementSize="ElementSize.Small"
                                        OnClick="ToggleMainContextMenuDropDown"
                                        Title="@Parameters?.ContentMenuTitle" />

                        <!-- Context Menu Dropdown -->
                        <div class="@GetMainContextMenuCss()" style="@GetMainContextMenuStyle()">
                            @foreach (var contextMenuButton in _mainContextMenu)
                            {
                                <button class="@Tailwind.Theme.Typography.BODY_MEDIUM @Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER block w-full px-4 py-2.5 text-left rounded-md transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                                        disabled="@contextMenuButton?.Disabled"
                                        @onclick="async () => { await ContextMenuClick(contextMenuButton); }">
                                    @contextMenuButton?.Title
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            @* Filter row *@
            @if (Parameters?.EnableFilters == true)
            {
                @foreach (var column in GetVisibleColumns())
                {
                    <div class="px-4 py-2 bg-zinc-50">
                        <input type="text"
                               id="@($"filter-{column.Key}-{Id}")"
                               class="@GetSearchInputCss()"
                               placeholder="@Parameters?.FilterPlaceholderText"
                               @oninput="(e) => UpdateColumnFilter(column.Key, e)"/>
                    </div>
                }
                @if (Parameters?.DisplaySelectColumn == true)
                {
                    <div class="px-4 py-2 bg-zinc-50"></div>
                }
                <div class="px-4 py-2 bg-zinc-50"></div>
            }
            @* Data rows *@
            @if (_collection != null)
            {
                foreach (var (row, rowIndex) in _collection.Rows.Select((r, i) => (r, i)))
                {
                    <div @key="row.Guid" style="display:contents" class="group">
                        @foreach (var col in GetVisibleColumns())
                        {
                            var cell = row.Cells.FirstOrDefault(c => c.ColumnKey == col.Key);
                            <div class="@GetCellBoxClassWithAlignment(col, rowIndex)"
                                 title="@cell?.Value"
                                 @onclick="async () => { await CellClick(cell); }">
                                <div class="@GetCellWrapperCss(col, cell)">
                                    @TrimCellValue(cell)
                                </div>
                            </div>
                        }

                        @if (Parameters?.DisplaySelectColumn == true)
                        {
                            <div class="@GetCellBoxClass(rowIndex, "justify-center")" @onclick:stopPropagation="true">
                                <MaviCheckbox @bind-Value="row.Selected"
                                              ThemeColorScheme="ThemeColorScheme.Default" />
                            </div>
                        }

                        <div class="@GetCellBoxClass(rowIndex, "text-right")">
                            @if (row.ContextActions.Any())
                            {
                                <div class="w-full flex items-center justify-end">
                                    @if (_gridState.TableRowContextMenuDisplayStyle == TableRowContextMenuDisplayStyle.Icons)
                                    {
                                        <div id="@row.ContextMenuId" data-context-menu-id="@row.ContextMenuId" class="flex items-center gap-1">
                                            @foreach (var rowContextMenuButton in row.ContextActions)
                                            {
                                                <MaviButtonIcon Icon="@rowContextMenuButton.Icon"
                                                                ElementVariant="rowContextMenuButton.ElementVariant"
                                                                ThemeColorScheme="rowContextMenuButton.ThemeColorScheme"
                                                                ElementSize="rowContextMenuButton.ElementSize"
                                                                Disabled="@rowContextMenuButton.Disabled"
                                                                OnClick="async (e) => { await RowContextMenuItemClick(e, row, rowContextMenuButton); }"
                                                                Title="@rowContextMenuButton.Title" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="@row.ContextMenuId" data-context-menu-id="@row.ContextMenuId" class="relative">
                                            <!-- Btn Toggle Context Menu Dropdown -->
                                            <MaviButtonIcon Icon="lni lni-menu-meatballs-1"
                                                            ElementVariant="ElementVariant.Text"
                                                            ThemeColorScheme="ThemeColorScheme.Default"
                                                            ElementSize="ElementSize.Small"
                                                            OnClick="(e) => { ToggleRowContextMenuDropDown(row, e); }"
                                                            Title="@Parameters?.ContentMenuTitle" />

                                            <!-- Row Context Menu Dropdown -->
                                            <div class="@GetRowContextMenuCss(row, rowIndex)" style="@GetRowContextMenuStyle(row)">
                                                @foreach (var rowContextMenuButton in row.ContextActions)
                                                {
                                                    <button class="@Tailwind.Theme.Typography.BODY_MEDIUM @Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER block w-full px-4 py-2.5 text-left rounded-md transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                                                            disabled="@rowContextMenuButton?.Disabled"
                                                            @onclick="async (e) => { await RowContextMenuItemClick(e, row, rowContextMenuButton); }">
                                                        @rowContextMenuButton?.Title
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @* ── Footer row – always spans every column ── *@
            <div id="@($"pagination-{Id}")" class="col-span-full" @onclick:stopPropagation="true">
                <div class="@GetFooterRowCss()">
                    <div class="flex items-center gap-2">
                        <span class="@GetPaginationTextCss()">@Parameters?.RowsPerPageText</span>
                        <select id="@($"select-row-number-{Id}")"
                                class="@GetCountPerPageSelectCss()"
                                @onchange="UpdatePageSize"
                                @onclick:stopPropagation="true"
                                title="@Parameters?.SelectNumberOfRowsToDisplayText">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        
                        <MaviButtonIcon Icon="lni lni-sliders-horizontal-square-2"
                                        ElementVariant="ElementVariant.Text"
                                        ThemeColorScheme="ThemeColorScheme.Dark"
                                        ElementSize="ElementSize.Regular"
                                        OnClick="KickOffSetVisibleColumnsModal"
                                        Title="Set Visible Columns" />
                    </div>
                    
                    <div class="flex items-center gap-3">
                        <div>
                            <input id="@($"goto-page-{Id}")"
                                   class="@GetCountPerPageSelectCss()"
                                   title="Go To Page"
                                   type="number"
                                   min="1"
                                   max="@(_collection?.TotalPages ?? 1)"
                                   @bind="_gridState.GoToPage"
                                   @bind:after="OnGoToPage" />
                        </div>
                        <div class="flex items-center gap-3">
                            @if (_collection is { Rows.Count: > 0 })
                            {
                                <div class="rounded-full p-1 @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER @Tailwind.Theme.Colors.Background.Active.THEME_DEFAULT_THREE_BG_ACTIVE">
                                    <MaviIconOnline IconOnlineType="IconOnlineType.ChevronLeftOnline"
                                                    IconColor="ElementColor.DimGrey"
                                                    IconSize="GetIconSize()"
                                                    OnClick="PrevPage"/>
                                </div>
                                <span class="@GetPaginationTextCss()">
                                    @_collection?.FirstRowIndex–@_collection?.LastRowIndex of @_collection?.TotalRows
                                </span>
                                <div class="rounded-full p-1 @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER @Tailwind.Theme.Colors.Background.Active.THEME_DEFAULT_THREE_BG_ACTIVE">
                                    <MaviIconOnline IconOnlineType="IconOnlineType.ChevronRightOnline"
                                                    IconColor="ElementColor.DimGrey"
                                                    IconSize="GetIconSize()"
                                                    OnClick="NextPage"/>
                                </div>
                            }
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    }
    else
    {
        @if (NoDataContent != null)
        {
            @NoDataContent
        }
        else
        {
            <div class="w-full min-h-40 flex items-center justify-center" style="min-width:20rem">
                <div class="@Tailwind.Theme.Typography.BODY_LARGE @Tailwind.Theme.Colors.Text.THEME_DEFAULT_SEVEN_TEXT">@Parameters?.NoDataAvailableTitle</div>
            </div>
        }
    }
</div>


@code
{
    private int VisibleColumnsCount => GetVisibleColumns().Count + 1 + (Parameters?.DisplaySelectColumn == true ? 1 : 0);

    private readonly MaviGridState _gridState = new();

    private MaviGridCollection<TKey>? _collection;

    private List<MaviGridColumn>? _visibleColumnsCache;

    private MaviBackdrop? _maviBackdrop;

    private IEnumerable<IMaviContextMenuItem>? _mainContextMenu;

    private DotNetObjectReference<MaviGrid<TDataItem, TModel, TKey>>? _dotNetRef;

    private readonly MaviGridDataQueryParameters _queryParameters = new();

    private CancellationTokenSource? _filterDebounceCts;

    private MaviDialog? _setVisibleColumnsDialog;
    private readonly MaviDialogBaseParameters _maviDialogBaseParameters = new()
    {
        ConfirmButtonTitle = "Set",
        Title = "Set Column Visibility",
        Width = "w-96"
    };

    // Snapshot of each column's Visible flag captured when the dialog opens, so Cancel can revert
    // the live edits the checkboxes make directly on the column objects.
    private Dictionary<string, bool>? _columnVisibilitySnapshot;

    [Inject]
    protected IJSRuntime? JsRuntime { get; set; }

    [Parameter]
    public MaviGridParameters Parameters { get; set; } = new();

    [Parameter]
    public Func<MaviGridDataQueryParameters, Task<MaviGridCollection<TKey>?>>? FetchData { get; set; }

    [Parameter]
    public Func<Task<IEnumerable<IMaviContextMenuItem>>>? ConstructMainContextMenu { get; set; }

    [Parameter]
    public EventCallback<IMaviContextMenuItem> OnMainContextMenuButtonClick { get; set; }

    [Parameter]
    public EventCallback<IMaviRowContextMenuItem<TKey>> OnRowContextMenuClick { get; set; }

    [Parameter]
    public EventCallback<CellClickParameters<TKey>> OnCellClick { get; set; }

    [Parameter]
    public RenderFragment? NoDataContent { get; set; }

    #region Lifecycle Actions

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _gridState.ContextMenuId = $"context-menu-{Id}";
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _gridState.TableRowContextMenuDisplayStyle = Parameters?.TableRowContextMenuDisplayStyle ?? TableRowContextMenuDisplayStyle.DropDown;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshTable();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SubscribeElements();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    #endregion

    #region Main Actions
    public async Task Refresh()
    {
        await RefreshTable();

        _gridState.NeedsRender = true;
        StateHasChanged();
    }

    public IEnumerable<MaviGridRow<TKey>> GetSelectedRows()
    {
        return _collection == null ? [] : _collection.GetSelectedRows();
    }

    private async Task RefreshTable()
    {
        try
        {
            _maviBackdrop?.Display();

            await BuildCollection();
            await BuildContextMenu();
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while refreshing the grid.");
        }
        finally
        {
            _maviBackdrop?.Hide();
            _gridState.BackdropInitialState = false;
        }

    }

    protected async Task BuildCollection()
    {
        try
        {
            if (FetchData != null)
            {     
                _collection = await FetchData.Invoke(_queryParameters);
                _gridState.NeedsRender = true;

                // Keep the go-to-page input in sync with the page actually returned (the factory may
                // clamp the requested page into range).
                if (_collection != null)
                {
                    _gridState.GoToPage = _collection.CurrentPage;
                }
            }

            _visibleColumnsCache = null;

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "Failed to fetch data for grid");
        }
    }

    protected async Task BuildContextMenu()
    {
        if (ConstructMainContextMenu != null)
        {
            try
            {
                _mainContextMenu = await ConstructMainContextMenu.Invoke();

                if (EnableLifeCycleLogging)
                {
                    Logger?.LogDebugLifeCycle(Id, GetType());
                }
            }
            catch (Exception ex)
            {
                Logger?.Error(ex, "Failed to construct main context menu.");
            }
        }
    }

    protected async Task RowContextMenuItemClick(MouseEventArgs args, MaviGridRow<TKey> row, IMaviRowContextMenuItem<TKey>? action)
    {
        try
        {
            row.ContextMenuVisible = false;

            if (OnRowContextMenuClick.HasDelegate)
            {
                await OnRowContextMenuClick.InvokeAsync(action);
            }

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while handling row context menu item click.");
        }
    }

    protected void ToggleRowContextMenuDropDown(MaviGridRow<TKey> row, MouseClickEventArgs mouseEventArgs)
    {
        row.ContextMenuVisible = !row.ContextMenuVisible;
        if (row.ContextMenuVisible)
            _gridState.ActiveRowMenuDropdownPositionStyle = $"top:{mouseEventArgs.ClientY + 8}px;left:{mouseEventArgs.ClientX - 248}px;";
    }

    protected IReadOnlyList<MaviGridColumn> GetVisibleColumns()
    {
        if (_visibleColumnsCache != null) return _visibleColumnsCache == null ? Array.Empty<MaviGridColumn>() : _visibleColumnsCache;

        if (_collection != null)
        {
            _visibleColumnsCache = _collection?.Columns
                .Where(c => c.Visible)
                .OrderBy(c => c.Sequence)
                .ToList();
        }

        return _visibleColumnsCache == null ? Array.Empty<MaviGridColumn>() : _visibleColumnsCache;
    }

    protected async Task PrevPage()
    {
        try
        {
            if (_queryParameters.PageNumber > 1)
            {
                _queryParameters.PageNumber--;
                await RefreshTable();

                if (EnableLifeCycleLogging)
                {
                    Logger?.LogDebugLifeCycle(Id, GetType());
                }
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while navigating to the previous page.");
        }
    }

    protected async Task NextPage()
    {
        try
        {
            if (_collection is not null)
            {
                var totalPages = _collection.TotalPages;

                if (_queryParameters.PageNumber < totalPages)
                {
                    _queryParameters.PageNumber++;
                    await RefreshTable();
                }

                if (EnableLifeCycleLogging)
                {
                    Logger?.LogDebugLifeCycle(Id, GetType());
                }
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while navigating to the next page.");
        }
    }

    protected async Task OnGoToPage()
    {
        try
        {
            if (_collection is null)
            {
                return;
            }

            // Clamp the entered value into the valid range [1, TotalPages] and reflect any correction
            // back into the bound input.
            var totalPages = Math.Max(_collection.TotalPages, 1);
            var requestedPage = Math.Clamp(_gridState.GoToPage, 1, totalPages);
            _gridState.GoToPage = requestedPage;

            if (requestedPage == _queryParameters.PageNumber)
            {
                // Nothing to fetch, but re-render so a clamped value shows in the input.
                _gridState.NeedsRender = true;
                return;
            }

            _queryParameters.PageNumber = requestedPage;
            await RefreshTable();

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while navigating to the requested page.");
        }
    }

    protected async Task SortByColumn(string columnKey)
    {
        try
        {
            if (_queryParameters.OrderByColumnKey == columnKey)
            {
                _queryParameters.SortOrder = _queryParameters.SortOrder == SortOrder.Ascending ? SortOrder.Descending : SortOrder.Ascending;
            }
            else
            {
                _queryParameters.OrderByColumnKey = columnKey;
                _queryParameters.SortOrder = SortOrder.Ascending;
            }

            await RefreshTable();

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, $"An error occurred while sorting by column with key '{columnKey}'.");
        }
    }

    protected async Task UpdatePageSize(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e?.Value?.ToString(), out var newSize))
            {
                return;
            }

            _queryParameters.NumberOfItemsPerPage = newSize;

            await RefreshTable();

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while updating the page size.");
        }
    }

    protected void ToggleMainContextMenuDropDown(MouseClickEventArgs mouseEventArgs)
    {
        _gridState.ContextMenuVisible = !_gridState.ContextMenuVisible;
        _gridState.NeedsRender = true;
    }

    protected async Task ContextMenuClick(IMaviContextMenuItem? action)
    {
        try
        {
            _gridState.ContextMenuVisible = false;

            if (OnMainContextMenuButtonClick.HasDelegate)
            {
                await OnMainContextMenuButtonClick.InvokeAsync(action);
            }

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while handling the main context menu button click.");
        }
    }

    protected async Task CellClick(MaviGridCell<TKey>? cell)
    {
        try
        {
            if (cell != null)
            {
                if (OnCellClick.HasDelegate)
                {
                    var parameters = new CellClickParameters<TKey>
                    {
                        RowKey = cell.RowKey,
                        ColumnKey = cell.ColumnKey,
                        CellBehavior = cell.CellBehavior
                    };

                    await OnCellClick.InvokeAsync(parameters);
                }
            }

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, "An error occurred while handling the row click.");
        }
    }

    protected void UpdateColumnFilter(string columnKey, ChangeEventArgs args)
    {
        // Capture the latest value and restart the debounce timer. The filter is only
        // applied once the user pauses typing for FilterDebounceMilliseconds.
        var filterText = args.Value?.ToString() ?? string.Empty;

        _filterDebounceCts?.Cancel();
        _filterDebounceCts?.Dispose();
        _filterDebounceCts = new();

        _ = ApplyColumnFilterDebouncedAsync(columnKey, filterText, _filterDebounceCts.Token);
    }

    private async Task ApplyColumnFilterDebouncedAsync(string columnKey, string filterText, CancellationToken token)
    {
        try
        {
            await Task.Delay(Parameters?.FilterDebounceMilliseconds ?? 400, token);

            if (string.IsNullOrWhiteSpace(filterText))
            {
                _queryParameters.RemoveFilter(columnKey);
            }
            else
            {
                var column = _collection?.Columns.FirstOrDefault(c => c.Key == columnKey);

                if (column != null && TryResolveColumnFilter(column, filterText, out var criteria, out var value))
                {
                    _queryParameters.AddFilter(columnKey, value, criteria);
                }
                else
                {
                    // The typed text does not resolve to a concrete filter for this column type
                    // (a non-numeric number, or a label that matches no bool/enum option). Drop the
                    // column filter rather than building an expression the query builder cannot run.
                    _queryParameters.RemoveFilter(columnKey);
                }
            }

            // Continuation runs off the renderer's sync context, so marshal back before
            // touching component state and triggering a re-render.
            await InvokeAsync(async () =>
            {
                await RefreshTable();

                _gridState.NeedsRender = true;
                StateHasChanged();
            });

            if (EnableLifeCycleLogging)
            {
                Logger?.LogDebugLifeCycle(Id, GetType());
            }
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke superseded this one; nothing to do.
        }
        catch (Exception ex)
        {
            Logger?.Error(ex, $"An error occurred while updating the filter for column with key '{columnKey}'.");
        }
    }

    /// <summary>
    /// Translates a typed-in filter fragment into the filter criteria and value appropriate for the
    /// column's data type. Strings use a substring match; numeric and date columns use equality; bool
    /// and enum columns match the typed fragment against their user-facing labels and translate it to
    /// the underlying value. Returns false when the text cannot be resolved to a concrete filter.
    /// </summary>
    private static bool TryResolveColumnFilter(MaviGridColumn column, string filterText, out MaviGridFilterCriteria criteria, out string value)
    {
        var text = filterText.Trim();

        // Equality is the default; only string columns do a partial (Contains) match.
        criteria = MaviGridFilterCriteria.Equals;
        value = text;

        switch (column.GridPropertyType)
        {
            case MaviGridPropertyType.String:
            case MaviGridPropertyType.NavString:
                criteria = MaviGridFilterCriteria.Contains;
                return true;

            case MaviGridPropertyType.Char:
            case MaviGridPropertyType.NavChar:
                return text.Length == 1;

            case MaviGridPropertyType.Int:
            case MaviGridPropertyType.NavInt:
                return long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out _)
                    || ulong.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out _);

            case MaviGridPropertyType.Decimal:
            case MaviGridPropertyType.NavDecimal:
                return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out _);

            case MaviGridPropertyType.DateTime:
            case MaviGridPropertyType.NavDateTime:
                return DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out _);

            case MaviGridPropertyType.TimeSpan:
            case MaviGridPropertyType.NavTimeSpan:
                return TimeSpan.TryParse(text, CultureInfo.InvariantCulture, out _);

            case MaviGridPropertyType.Guid:
            case MaviGridPropertyType.NavGuid:
                return Guid.TryParse(text, out _);

            case MaviGridPropertyType.Bool:
            case MaviGridPropertyType.NavBool:
                return TryResolveBoolFilter(column, text, out value);

            case MaviGridPropertyType.Enum:
            case MaviGridPropertyType.NavEnum:
                return TryResolveEnumFilter(column, text, out value);

            default:
                // Undefined: let the query builder coerce the text on equality.
                return true;
        }
    }

    private static bool TryResolveBoolFilter(MaviGridColumn column, string text, out string value)
    {
        // Match the typed fragment against the user-facing positive / negative labels and translate
        // to the bool the query builder understands. Positive is checked first to break ambiguity.
        var positive = column.BoolPositiveDisplay ?? bool.TrueString;
        var negative = column.BoolNegativeDisplay ?? bool.FalseString;

        if (LabelContains(positive, text))
        {
            value = bool.TrueString;
            return true;
        }

        if (LabelContains(negative, text))
        {
            value = bool.FalseString;
            return true;
        }

        value = text;
        return false;
    }

    private static bool TryResolveEnumFilter(MaviGridColumn column, string text, out string value)
    {
        // PossibleFilterValues maps each enum member name (key) to its display text (value, which
        // falls back to the member name when no [Display] attribute is present). Match the typed
        // fragment against the display text and translate to the member name, which the query builder
        // parses back into the concrete enum member.
        if (column.PossibleFilterValues != null)
        {
            foreach (var option in column.PossibleFilterValues)
            {
                if (LabelContains(option.Value, text))
                {
                    value = option.Key;
                    return true;
                }
            }
        }

        value = text;
        return false;
    }

    private static bool LabelContains(string? label, string text)
        => !string.IsNullOrEmpty(label) && label.Contains(text, StringComparison.OrdinalIgnoreCase);

    protected string TrimCellValue(MaviGridCell<TKey>? cell)
    {
        if (cell?.Value is null) return string.Empty;

        return Parameters.MaxCellCharsToDisplay > 0 ? cell.Value.TrimToLengthWithDots(Parameters.MaxCellCharsToDisplay) : cell.Value;
    }

    protected override bool ShouldRender()
    {
        if (!_gridState.NeedsRender) return false;

        _gridState.NeedsRender = false;
        return true;
    }

