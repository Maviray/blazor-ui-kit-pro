@using Maviray.Blazor.Components.Core.Components
@using Maviray.Blazor.Components.Core.Enums
@using Maviray.Blazor.Components.Material.Components.Feedback
@using Maviray.Blazor.Components.Material.Components.Inputs
@using Maviray.Blazor.Components.Material.Components.Spinner
@using Maviray.Blazor.Components.Pro.Core.Models.Grid
@inherits MaviComponentBase
@typeparam TKey where TKey : IEquatable<TKey>

@{
    var view = Layout;
}

@* A parameter, not a consumer class: block and inline-block on one element resolve by stylesheet order. *@
<div data-grid id="@Id" class="@(Parameters.FillWidth ? "block w-full" : "inline-block max-w-full") rounded-xl border border-zinc-200 text-sm min-h-40 relative @Class" style="overflow:auto;@Style" aria-busy="@(_busy ? "true" : "false")">
    @if (_busy)
    {
        <div class="absolute inset-0 z-40 flex items-center justify-center bg-white/60">
            <MaviSpinnerStarRotate ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Regular" />
        </div>
    }

    @if (_columnChoices is { } choices)
    {
        @* Mounted only while open, so a closed dialog costs nothing on each render. The content iterates its own copy:
           the dialog can render once more while it closes. *@
        <MaviDialog @ref="_columnsDialog" DialogButtonClick="OnColumnsDialogButtonAsync" MaviDialogBaseParameters="ColumnsDialogParameters">
            <div class="flex flex-col gap-4">
                @foreach (var choice in choices)
                {
                    <MaviCheckbox @bind-Value="choice.Visible" ElementSize="ElementSize.Regular" Label="@choice.Title" />
                }
            </div>
        </MaviDialog>
    }

    @if (_prerenderSkipped)
    {
        <div data-grid-state="prerender" role="status" aria-live="polite" class="w-full min-h-40 p-4" style="min-width:20rem">
            @if (PrerenderContent is not null)
            {
                @PrerenderContent
            }
            else
            {
                <MaviSkeleton Lines="5" FullWidth="true" />
            }
        </div>
    }
    else if (_fetchError is not null)
    {
        <div data-grid-state="fetch-error" role="alert" class="@MaviGridLayout.StateCss" style="min-width:20rem">
            @if (FetchErrorContent is not null)
            {
                @FetchErrorContent
            }
            else if (!_busy)
            {
                <span class="@MaviGridLayout.StateTextCss">@Parameters.FetchErrorTitle</span>
                <MaviButtonIcon Icon="lni lni-refresh-circle-1-clockwise" ElementVariant="ElementVariant.Filled" ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Large" OnClick="RefreshAsync" Title="Retry" />
            }
        </div>
    }
    else if (_page is not null)
    {
        <div data-grid-body class="grid divide-y divide-zinc-200" style="@view.GridStyle">
            @foreach (var column in view.Columns)
            {
                <div data-column-header class="@view.HeaderCellCss">
                    @if (column.Sortable)
                    {
                        var direction = _page.SortColumnKey == column.Key ? (_page.SortOrder == SortOrder.Ascending ? "ascending" : "descending") : null;
                        <button type="button" data-sort-key="@column.Key" data-sort-direction="@direction" aria-label="@($"Sort by {column.Title}")"
                                class="@MaviGridLayout.HeaderButtonCss @MaviGridLayout.HeaderTextCss @MaviGridLayout.HeaderButtonHoverCss" @onclick="() => SortAsync(column)">
                            <span>@column.Title</span>
                            @if (direction is not null)
                            {
                                <i class="lni @(direction == "ascending" ? "lni-chevron-up" : "lni-chevron-down")" aria-hidden="true"></i>
                            }
                        </button>
                    }
                    else
                    {
                        <span class="@MaviGridLayout.HeaderTextCss select-none opacity-70">@column.Title</span>
                    }
                </div>
            }

            @if (view.ShowSelect)
            {
                <div data-select-header class="@view.SelectHeaderCss">
                    <span class="@MaviGridLayout.HeaderTextCss select-none">Select</span>
                </div>
            }

            <div class="@view.MenuCellCss">
                @if (_mainMenu.Count > 0)
                {
                    <div data-main-menu-toggle id="@MainMenuId" data-context-menu-id="@MainMenuId" class="relative flex justify-end">
                        <MaviButtonIcon Icon="lni lni-menu-meatballs-1" ElementVariant="ElementVariant.Text" ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Small" OnClick="ToggleMainMenu" Title="@Parameters.ContentMenuTitle" />
                        @* Fixed where the user clicked, like the row menu: the header cell truncates and the grid scrolls,
                           so a dropdown positioned inside them would be clipped. *@
                        <div data-main-menu class="@(_mainMenuOpen ? $"{MaviGridLayout.DropdownCss} fixed" : "hidden")" style="@(_mainMenuOpen ? _mainMenuStyle : null)">
                            @foreach (var item in _mainMenu)
                            {
                                <button type="button" data-menu-item class="@MaviGridLayout.MenuItemCss" disabled="@(item.Disabled == true)" @onclick="() => OnMainMenuItemAsync(item)">@item.Title</button>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (view.ShowFilters)
            {
                @foreach (var column in view.Columns)
                {
                    <div class="@MaviGridLayout.FilterCellCss">
                        @if (column.Filterable)
                        {
                            <input type="text" data-filter-key="@column.Key" id="@($"{Id}-filter-{column.Key}")" class="@MaviGridLayout.FilterInputCss"
                                   placeholder="@Parameters.FilterPlaceholderText" aria-label="@($"Filter {column.Title}")"
                                   value="@FilterText(column.Key)" @oninput="e => OnFilterInput(column.Key, e)" />
                        }
                    </div>
                }
                @if (view.ShowSelect)
                {
                    <div class="@MaviGridLayout.FilterCellCss"></div>
                }
                <div class="@MaviGridLayout.FilterCellCss"></div>
            }

            @if (_page.AccessDenied)
            {
                <div data-grid-state="access-denied" role="alert" class="@MaviGridLayout.StateCss" style="min-width:20rem">
                    @if (AccessDeniedContent is not null)
                    {
                        @AccessDeniedContent
                    }
                    else
                    {
                        <span class="@MaviGridLayout.StateTextCss">@(_page.AccessDeniedMessage ?? Parameters.AccessDeniedTitle)</span>
                    }
                </div>
            }
            else if (_page.Rows.Count == 0)
            {
                <div data-grid-state="no-data" role="status" class="@MaviGridLayout.StateCss" style="min-width:20rem">
                    @if (!_busy)
                    {
                        @if (NoDataContent is not null)
                        {
                            @NoDataContent
                        }
                        else
                        {
                            <span class="@MaviGridLayout.StateTextCss">@Parameters.NoDataAvailableTitle</span>
                            <MaviButtonIcon Icon="lni lni-refresh-circle-1-clockwise" ElementVariant="ElementVariant.Filled" ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Large" OnClick="ClearFiltersAndReloadAsync" Title="Clear filters and reload" />
                        }
                    }
                </div>
            }
            else
            {
                @for (var index = 0; index < _page.Rows.Count; index++)
                {
                    var row = _page.Rows[index];
                    <MaviGridRowView @key="row.Key" TKey="TKey" Grid="this" Row="row" RowIndex="index" LayoutVersion="LayoutVersion"
                                     Selected="_selectedKeys.Contains(row.Key)" MenuOpen="_openRowMenu == index" MenuStyle="@(_openRowMenu == index ? _rowMenuStyle : null)" />
                }

                <div data-pager class="col-span-full">
                    <div class="@view.FooterCss">
                        <div class="flex items-center gap-2">
                            <span class="@view.PagerTextCss">@Parameters.RowsPerPageText</span>
                            <select data-page-size class="@view.PagerInputCss" title="@Parameters.SelectNumberOfRowsToDisplayText" @onchange="OnPageSizeChangedAsync">
                                @foreach (var size in PageSizeChoices())
                                {
                                    <option value="@size" selected="@(size == _pageSize)">@size</option>
                                }
                            </select>
                            <span data-columns-toggle><MaviButtonIcon Icon="lni lni-sliders-horizontal-square-2" ElementVariant="ElementVariant.Text" ThemeColorScheme="ThemeColorScheme.Dark" ElementSize="ElementSize.Regular" OnClick="OpenColumnsDialog" Title="Set visible columns" /></span>
                        </div>
                        <div class="flex items-center gap-3">
                            <input data-page-goto type="number" min="1" max="@Math.Max(_page.TotalPages, 1)" value="@_pageNumber" class="@view.PagerInputCss" title="Go to page" aria-label="Go to page" @onchange="OnGoToPageAsync" />
                            <span data-page-prev>
                                <MaviButtonIcon Icon="lni lni-chevron-left" ElementVariant="ElementVariant.Text" ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Small" Disabled="@(_pageNumber <= 1)" OnClick="PreviousPageAsync" Title="@Parameters.GoToPreviousPageText" />
                            </span>
                            <span class="@view.PagerTextCss">@_page.FirstRowNumber–@_page.LastRowNumber of @_page.TotalRows</span>
                            <span data-page-next>
                                @* LineIcons 5 has no lni-chevron-right: the left chevron, mirrored, matches the previous-page button. *@
                                <MaviButtonIcon Icon="lni lni-chevron-left lni-flip-x" ElementVariant="ElementVariant.Text" ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Small" Disabled="@(_pageNumber >= _page.TotalPages)" OnClick="NextPageAsync" Title="@Parameters.GoToNextPageText" />
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
