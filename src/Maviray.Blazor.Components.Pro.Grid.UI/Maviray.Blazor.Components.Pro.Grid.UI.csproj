<Project Sdk="Microsoft.NET.Sdk.Razor">

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="npm install @tailwindcss/forms" />
		<Exec Command="npm run buildcss" />
	</Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<IsPackable>true</IsPackable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

	  <!-- NuGet Package Properties -->
	  <PackageId>Maviray.Blazor.Components.Pro.Grid.UI</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>Maviray</Authors>
	  <Company>Maviray</Company>
	  <Copyright>Copyright @2026 Maviray</Copyright>
	  <Description>Blazor Grid UI</Description>
	  <PackageTags>blazor;grid;ui;maviray</PackageTags>
	  <RepositoryUrl>https://github.com/Maviray/blazor-ui-kit</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/Maviray/blazor-ui-kit</PackageProjectUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageIcon>icon.png</PackageIcon>
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <IsPackable>true</IsPackable>
	  <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

	
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Areas\" />
    <Folder Include="wwwroot\css\" />
    <Folder Include="wwwroot\js\" />
  </ItemGroup>


	<ItemGroup>
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="Maviray.Blazor.Components.Material" Version="0.1.23" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\Maviray.Blazor.Components.Pro.Core\Maviray.Blazor.Components.Pro.Core.csproj" />
	</ItemGroup>
</Project>
