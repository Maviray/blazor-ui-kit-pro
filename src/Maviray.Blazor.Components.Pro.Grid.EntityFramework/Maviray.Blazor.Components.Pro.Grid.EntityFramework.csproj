<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

	  <!-- NuGet Package Properties -->
	  <PackageId>Maviray.Blazor.Components.Pro.Grid.EntityFramework</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>Maviray</Authors>
	  <Company>Maviray</Company>
	  <Copyright>Copyright (c) 2026 Maviray</Copyright>
	  <Description>Blazor Grid EntityFramework</Description>
	  <PackageTags>blazor;grid;entityframework;maviray</PackageTags>
	  <RepositoryUrl>https://github.com/Maviray/blazor-ui-kit-pro</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/Maviray/blazor-ui-kit-pro</PackageProjectUrl>
	  <RepositoryType>git</RepositoryType>
	  <!-- An SPDX expression, so package feeds and license scanners recognize MIT. LICENSE.txt still ships in the
	       package (below), keeping the copyright notice MIT requires in every copy. -->
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageIcon>icon.png</PackageIcon>
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <IsPackable>true</IsPackable>
	  <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

	<ItemGroup>
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Maviray.Blazor.Components.Pro.Core\Maviray.Blazor.Components.Pro.Core.csproj" />
	</ItemGroup>
</Project>
