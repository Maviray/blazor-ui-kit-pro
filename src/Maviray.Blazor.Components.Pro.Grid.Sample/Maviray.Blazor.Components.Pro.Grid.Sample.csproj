<Project Sdk="Microsoft.NET.Sdk.Web">

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="npm install @tailwindcss/forms" />
		<Exec Command="npm run buildcss" />
	</Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<IsPackable>false</IsPackable>
	<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maviray.Blazor.Components.Pro.Grid.EntityFramework\Maviray.Blazor.Components.Pro.Grid.EntityFramework.csproj" />
    <ProjectReference Include="..\Maviray.Blazor.Components.Pro.Grid.Sample.Database\Maviray.Blazor.Components.Pro.Grid.Sample.Database.csproj" />
    <ProjectReference Include="..\Maviray.Blazor.Components.Pro.Grid.UI\Maviray.Blazor.Components.Pro.Grid.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
  </ItemGroup>

</Project>
