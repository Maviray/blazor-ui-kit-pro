<DocSection Anchor="appearance" Number="8" Title="Look and texts"
            Summary="Striped rows, a condensed layout, shortened cell text, column widths, and every text the grid shows: change them through Parameters, for example to translate them.">

    <div class="@DocStyles.Demo">
        <MaviGrid TKey="int" FetchData="FetchPageAsync" Parameters="_parameters" ConstructMainContextMenu="BuildMenuAsync" />
    </div>

    <DocCode Code="@DocSnippets.Appearance" />

    <p class="@DocStyles.Body mt-4">
        The full list of texts is in reference table 1.3. <code>Class</code> and <code>Style</code> add classes and
        inline style to the grid's outer element.
    </p>

    <h3 class="@DocStyles.SubTitle">8.1 Column widths</h3>
    <p class="@DocStyles.Body mb-3">
        The grid fills the width it is given. Columns keep their width (up to 200px, more if their content needs it)
        unless they stretch. With no stretching column, as in the grid above, the actions column takes the free width,
        so the ⋯ menu sits at the right edge. Mark columns with <code>[GridStretch]</code> on the model, or choose them
        per grid with <code>StretchColumns</code>; weights split the free width between them. The free width is what
        is left once the other columns reach 200px, so in a narrow grid a stretching column only gets the room its
        content needs.
    </p>

    @* Full width: stretching columns share only the width left once the other columns reach 200px. *@
    <div class="flex flex-col gap-6">
        <div>
            <h3 class="@DocStyles.Label mb-2">One column stretches: Name</h3>
            <div class="@DocStyles.Demo">
                <MaviGrid TKey="int" FetchData="FetchPageAsync" Parameters="_nameStretches" ConstructMainContextMenu="BuildMenuAsync" />
            </div>
        </div>
        <div>
            <h3 class="@DocStyles.Label mb-2">Weights: Name 2, Created 1</h3>
            <div class="@DocStyles.Demo">
                <MaviGrid TKey="int" FetchData="FetchPageAsync" Parameters="_weighted" ConstructMainContextMenu="BuildMenuAsync" />
            </div>
        </div>
    </div>

    <DocCode Code="@DocSnippets.ColumnWidths" />

    <p class="@DocStyles.Body mt-4">
        <code>StretchColumns</code> replaces the model's marks for one grid; an empty dictionary stretches no column.
        To change it later, assign a new dictionary. <code>FillWidth = false</code> brings back a grid that shrinks to
        its columns.
    </p>
</DocSection>

@code {
    private readonly MaviGridParameters _parameters = new()
    {
        Striped = true,
        Condensed = true,
        MaxCellCharsToDisplay = 6,
        RowsPerPageText = "Items per page",
        SelectNumberOfRowsToDisplayText = "How many items to show",
        GoToPreviousPageText = "Back",
        GoToNextPageText = "Forward",
        ContentMenuTitle = "More",
        NoDataAvailableTitle = "Nothing here yet"
    };

    private readonly MaviGridParameters _nameStretches = new() { StretchColumns = new Dictionary<string, int> { ["Name"] = 1 } };

    private readonly MaviGridParameters _weighted = new() { StretchColumns = new Dictionary<string, int> { ["Name"] = 2, ["Date"] = 1 } };

    [Inject]
    private IGridDataFactory<DbSampleItemOne, DocItemModel, int> GridData { get; set; } = default!;

    private Task<MaviGridCollection<int>> FetchPageAsync(MaviGridQuery query, CancellationToken cancellationToken) =>
        GridData.BuildPageAsync(query, cancellationToken: cancellationToken);

    private static Task<IEnumerable<IMaviContextMenuItem>> BuildMenuAsync() =>
        Task.FromResult<IEnumerable<IMaviContextMenuItem>>([new MaviContextMenuItem { Key = "export", Title = "Export" }]);
}
