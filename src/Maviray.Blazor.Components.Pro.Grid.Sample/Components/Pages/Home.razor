@page "/"
@using Maviray.Blazor.Components.Core.Enums
@using Maviray.Blazor.Components.Pro.Core.Interfaces
@using Maviray.Blazor.Components.Pro.Core.Interfaces.Grid
@using Maviray.Blazor.Components.Pro.Core.Models
@using Maviray.Blazor.Components.Pro.Core.Models.Grid
@using Maviray.Blazor.Components.Pro.Core.Models.Grid.Menu
@using Maviray.Blazor.Components.Pro.Grid.Sample.Database.Enums
@using Maviray.Blazor.Components.Pro.Grid.Sample.Database.Models
@using Maviray.Blazor.Components.Pro.Grid.Sample.Models
@using Maviray.Blazor.Components.Pro.Grid.UI.Components

<PageTitle>Home</PageTitle>

<div class="p-4">
    <MaviGrid @ref="_grid" TKey="int"
              FetchData="FetchPageAsync"
              Parameters="_gridParameters"
              ConstructMainContextMenu="BuildMainMenuAsync"
              OnMainContextMenuButtonClick="OnMainMenuItemClickAsync"
              OnRowContextMenuClick="OnRowAction"
              OnCellClick="OnCellClick" />
</div>

@code
{
    // Badge colours for the graphic columns, keyed by column key. Each resolver gets the raw property value.
    private static readonly GridFetchOptions<DbSampleItemOne, DbSampleItemOneModel> FetchOptions = new()
    {
        CellThemes = new Dictionary<string, Func<object?, ThemeColorScheme>>
        {
            ["Integer"] = value => value switch
            {
                int n when n < 100 => ThemeColorScheme.Primary,
                int n when n < 300 => ThemeColorScheme.Secondary,
                int n when n < 500 => ThemeColorScheme.Success,
                int n when n < 700 => ThemeColorScheme.Alert,
                int => ThemeColorScheme.Warning,
                _ => ThemeColorScheme.Default
            },
            ["SampleEnum"] = value => value switch
            {
                SampleEnum.One => ThemeColorScheme.Primary,
                SampleEnum.Two => ThemeColorScheme.Secondary,
                SampleEnum.Three => ThemeColorScheme.Success,
                SampleEnum.Four => ThemeColorScheme.Alert,
                SampleEnum.Five => ThemeColorScheme.Warning,
                SampleEnum.Six => ThemeColorScheme.Info,
                _ => ThemeColorScheme.Default
            }
        }
    };

    private readonly MaviGridParameters _gridParameters = new()
    {
        EnableFilters = true,
        TableRowContextMenuDisplayStyle = TableRowContextMenuDisplayStyle.Icons,
        DisplaySelectColumn = true,
        SortColumnKey = "Id"
    };

    private MaviGrid<int>? _grid;

    [Inject]
    private IGridDataFactory<DbSampleItemOne, DbSampleItemOneModel, int> DataFactory { get; set; } = default!;

    [Inject]
    private ILogger<Home> Logger { get; set; } = default!;

    private Task<MaviGridCollection<int>> FetchPageAsync(MaviGridQuery query, CancellationToken cancellationToken) =>
        DataFactory.BuildPageAsync(query, FetchOptions, cancellationToken);

    private static Task<IEnumerable<IMaviContextMenuItem>> BuildMainMenuAsync() =>
        Task.FromResult<IEnumerable<IMaviContextMenuItem>>(
        [
            new MaviContextMenuItem { Key = "add", Title = "Add" },
            new MaviContextMenuItem { Key = "delete-selected", Title = "Delete Selected" },
            new MaviContextMenuItem { Key = "refresh", Title = "Refresh" }
        ]);

    private async Task OnMainMenuItemClickAsync(IMaviContextMenuItem item)
    {
        Logger.LogInformation("Main menu item {Key} clicked; {Count} rows selected.", item.Key, _grid?.SelectedKeys.Count);

        if (item.Key == "refresh" && _grid is not null)
        {
            await _grid.RefreshAsync();
        }
    }

    private void OnRowAction(IMaviRowContextMenuItem<int> action) =>
        Logger.LogInformation("Row action {Title} clicked for row {Key}.", action.Title, action.Key);

    private void OnCellClick(CellClickParameters<int> cell) =>
        Logger.LogInformation("Cell clicked. Row: {RowKey}, column: {ColumnKey}.", cell.RowKey, cell.ColumnKey);
}
