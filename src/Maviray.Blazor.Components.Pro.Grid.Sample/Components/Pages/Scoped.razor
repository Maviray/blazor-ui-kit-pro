@page "/scoped"
@using Maviray.Blazor.Components.Pro.Core.Interfaces.Grid
@using Maviray.Blazor.Components.Pro.Core.Models.Grid
@using Maviray.Blazor.Components.Pro.Grid.Sample.Database.Models
@using Maviray.Blazor.Components.Pro.Grid.Sample.Models
@using Maviray.Blazor.Components.Pro.Grid.Sample.Services
@using Maviray.Blazor.Components.Pro.Grid.UI.Components

<PageTitle>Scoped items</PageTitle>

<div class="p-4 flex flex-col gap-4">
    <div class="text-sm text-zinc-600 max-w-3xl">
        This grid shows <code>DbSampleItemThree</code>, which implements <code>IScopedItem</code>. The page passes no
        filter: a global filter (<code>ScopedItemGridFilter</code>, registered once with <code>AddGlobalFilter</code>)
        limits the rows to the current user's scopes (<strong>@AllowedScopes</strong>) and auth areas
        (<strong>@AllowedAuthAreas</strong>). Of the 27 seeded items only the matching ones are shown, and column
        filters apply on top.
    </div>

    <MaviGrid TKey="int" FetchData="FetchPageAsync" Parameters="_gridParameters" />
</div>

@code
{
    private readonly MaviGridParameters _gridParameters = new()
    {
        EnableFilters = true,
        SortColumnKey = "Id"
    };

    [Inject]
    private IGridDataFactory<DbSampleItemThree, DbSampleItemThreeModel, int> DataFactory { get; set; } = default!;

    [Inject]
    private IUserScopeContext UserScope { get; set; } = default!;

    private string AllowedScopes => string.Join(", ", UserScope.AllowedScopeIds);

    private string AllowedAuthAreas => string.Join(", ", UserScope.AllowedAuthAreaIds);

    private Task<MaviGridCollection<int>> FetchPageAsync(MaviGridQuery query, CancellationToken cancellationToken) =>
        DataFactory.BuildPageAsync(query, cancellationToken: cancellationToken);
}
