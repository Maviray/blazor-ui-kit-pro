@page "/property-mapping"
@using Maviray.Blazor.Components.Pro.Core.Interfaces.Grid
@using Maviray.Blazor.Components.Pro.Core.Models.Grid
@using Maviray.Blazor.Components.Pro.Grid.Sample.Database.Enums
@using Maviray.Blazor.Components.Pro.Grid.Sample.Database.Models
@using Maviray.Blazor.Components.Pro.Grid.Sample.Models
@using Maviray.Blazor.Components.Pro.Grid.UI.Components
@using Microsoft.EntityFrameworkCore

<PageTitle>Custom Property Mapping</PageTitle>

<div class="p-4 flex flex-col gap-4">
    <div class="text-sm text-zinc-600 max-w-3xl">
        This grid shows <code>OrderItem</code>, whose <code>OrderItemGridModel</code> mixes four kinds of columns:
        direct one-to-one properties (<strong>Id</strong>, <strong>Product Name</strong>, <strong>Is Backordered</strong>,
        <strong>Quantity</strong>, <strong>Unit Price</strong>), properties mapped through related entities with a
        <code>GridPropertyPathMap</code> (<strong>Order Number</strong>, <strong>Customer Company</strong>,
        <strong>Country</strong>), properties mapped the same way with a default for a customer with no region
        (<strong>Region Rating (or Default)</strong>, <strong>Is International (or Default)</strong>), and two computed
        columns with no single data path (<strong>Total Line Value</strong>, <strong>Full Description</strong>), which
        therefore can't be sorted or filtered.
    </div>

    <MaviGrid TKey="int" FetchData="FetchPageAsync" Parameters="_gridParameters" />
</div>

@code
{
    // Built once and shared by every fetch, so the factory reuses the columns it builds for this map.
    private static readonly GridFetchOptions<OrderItem, OrderItemGridModel> FetchOptions = new()
    {
        Include = query => query
            .Include(i => i.Order)
            .ThenInclude(o => o!.Customer)
            .ThenInclude(c => c!.Region)
            .ThenInclude(r => r!.Country),
        PropertyPathMap = new GridPropertyPathMap<OrderItem, OrderItemGridModel>()
            .Map(m => m.OrderNumber, "Order.OrderNumber")
            .Map(m => m.CustomerCompanyName, "Order.Customer.CompanyName")
            .Map(m => m.CountryName, "Order.Customer.Region.Country.CountryName")
            .Map(m => m.RegionRatingOrDefault, "Order.Customer.Region.Rating", nullDefault: RatingEnum.Low)
            .Map(m => m.IsInternationalOrDefault, "Order.Customer.Region.IsInternational", nullDefault: false)
    };

    private readonly MaviGridParameters _gridParameters = new()
    {
        EnableFilters = true,
        SortColumnKey = "Id"
    };

    [Inject]
    private IGridDataFactory<OrderItem, OrderItemGridModel, int> DataFactory { get; set; } = default!;

    private Task<MaviGridCollection<int>> FetchPageAsync(MaviGridQuery query, CancellationToken cancellationToken) =>
        DataFactory.BuildPageAsync(query, FetchOptions, cancellationToken);
}
